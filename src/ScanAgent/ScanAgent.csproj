<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FileAccessGovernance.ScanAgent</RootNamespace>
    <!--
      Deliberately net8.0, not net8.0-windows: keeps the project buildable in CI on
      any OS (P/Invoke declarations compile everywhere; only running them requires
      Windows). Win32-only calls are isolated to Security/NativeMethods.cs and
      Security/Win32SecurityDescriptorReader.cs — see ISecurityDescriptorReader for
      the swappable fake used in local dev on non-Windows machines (design doc §7).
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.5.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
